# Copy to .env and fill in real values. Never commit .env.
DATABASE=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fashi
SESSION_SECRET=<long random string>
# Base URL used in password-reset emails
APP_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gmail address + app password used to send OTP and reset emails
MAIL_USER=
MAIL_PASS=

# Optional
# PORT=3000
# NODE_ENV=production   (secure cookies; needs HTTPS)
