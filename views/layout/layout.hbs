<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{csrfToken}}">
    {{#if admin}}
    {{>adminLinks}}
    {{/if}}
    {{#if user}}
    {{>links}}
    {{/if}}
    <script>
        // Every AJAX request that changes data must carry the CSRF token.
        if (window.jQuery) {
            jQuery.ajaxSetup({ headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content } });
        }
        // Updates the number on the header's cart icon (hidden when the cart is empty).
        function setCartCount(count) {
            var badge = document.getElementById('cart-count');
            if (!badge || typeof count !== 'number') return;
            badge.textContent = count > 99 ? '99+' : count;
            badge.style.display = count > 0 ? '' : 'none';
        }
    </script>
</head>
<body>
    {{#if admin}}
    {{>adminHeader}}
    {{/if}}
    {{#if user}}
    {{>userHeader}}
    {{/if}}
   {{{body}}}

    {{#if admin}}
    {{>adminFooter}}
    {{/if}}
    {{#if user}}
    {{>footer}}
    {{/if}}
</body>
</html>
